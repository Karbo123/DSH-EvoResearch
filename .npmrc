# npm 安装脚本白名单（本机 npm 11.x 的 allow-scripts 安全特性）。
# fs-ext：0.1.3 起 dsh 树的原生依赖（dsh-session-persistence-jsonl 文件锁），
# 需要 node-gyp 构建；构建由 devDep 的 node-gyp@13 经 node_modules/.bin 提供
# （npm/pnpm 内置 node-gyp 12.x 在 Node 26 头文件下传 LLD 旗标导致 LNK1117）。
allow-scripts=@deepseek-ai/dsh-subprocess-local,koffi,node-pty,@google/genai,protobufjs,fs-ext
